#include "constants.fc";

(slice, slice, slice) load_data() {
    slice ds = get_data().begin_parse();
    var (owner_address, main_address, echo_address) = (ds~load_msg_addr(), ds~load_msg_addr(), ds~load_msg_addr());
    return (owner_address, main_address, echo_address);
}

() save_data(slice owner_address, slice main_address, slice echo_address) impure inline {
  set_data(begin_cell()
    .store_slice(owner_address)
    .store_slice(main_address)
    .store_slice(echo_address)
    .end_cell());
}

slice convert_to_string(int result) {
  builder string = begin_cell();
  tuple chars = null();
  do {
      int r = result~divmod(10);
      chars = cons(r + 48, chars);
  } until (result == 0);
  do {
      int char = chars~list_next();
      string~store_uint(char, 8);
  } until (null?(chars));

  slice final = string.end_cell().begin_parse();
  return final;
}

(slice) int_to_slice(int time) {
    builder string = begin_cell();
    tuple chars = null();
    int hourSecret = time;
    do { int r = time~divmod(10); chars = cons(r + 48, chars);  
    } until (time == 0);
    if hourSecret < 10 { chars = cons(48, chars); }
    do { int char = chars~list_next(); string~store_uint(char, 8);
    } until (null?(chars));
    slice sliceTime = string.end_cell().begin_parse();
    return sliceTime;
}

(slice) create_result_message_d(slice first, slice second, slice sum, slice choice, int resultType) {
  if resultType == 0 {
    slice msgText = begin_cell()
        .store_slice("🎲 Dice: 😞 Lost. Bet: ")
        .store_slice(choice)
        .store_slice(" ✏️Result: ")
        .store_slice(first)
        .store_slice("+")
        .store_slice(second)
        .store_slice("=")
        .store_slice(sum)
        .store_slice(" 🔗 tonMinute")
        .end_cell()
        .begin_parse();
    return msgText;
  } else {
    slice msgText = begin_cell()
        .store_slice("🎲 Dice: 🎉 You Won! Bet: ")
        .store_slice(choice)
        .store_slice(" ✏️Result: ")
        .store_slice(first)
        .store_slice("+")
        .store_slice(second)
        .store_slice("=")
        .store_slice(sum)
        .store_slice(" 🔗 tonMinute")
        .end_cell()
        .begin_parse();
    return msgText;
  }
}

