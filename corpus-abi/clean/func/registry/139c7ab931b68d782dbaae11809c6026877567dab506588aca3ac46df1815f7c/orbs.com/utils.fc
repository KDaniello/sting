}

() send_grams(slice address, int amount) impure {
  cell msg = begin_cell()
    .store_uint (0x18, 6)
    .store_slice(address)
    .store_grams(amount)
    .store_uint(0, 107)
    .end_cell(); 
  send_raw_message(msg, 3); ;; mode, 2 for ignoring errors, 1 for sender pays fees, 64 for returning inbound message value
}

() send_result_message(slice address, int amount, slice result, int bet, slice ref_addr) impure {
  (slice owner_address, slice main_address, slice echo_address) = load_data();
  var [balance, _] = get_balance();
  var itog_amount = amount;
  if amount > balance {
    if bet + 60000000 > balance {
        itog_amount = balance - (balance * 20 / 100);
    } else {
        itog_amount = bet;
    }
    result = "You won,but the contract lacks enough funds to pay in full"; 
  }

  cell msg = begin_cell()
    .store_uint (0x18, 6)
    .store_slice(address)
    .store_grams(itog_amount)
    .store_uint(0, 107)
    .store_uint(0, 32)
    .store_slice(result)
    .end_cell(); 
  send_raw_message(msg, 3);
  if ~ equal_slices(ref_addr, owner_address) {
    if ~ equal_slices(ref_addr, address) {
        if itog_amount == 0 {
            int ref_amount = bet / 100 * 5 - 150000; 
            cell ref_msg = begin_cell()
              .store_uint (0x18, 6)
              .store_slice(ref_addr)
              .store_grams(ref_amount)
              .store_uint(0, 107)
              .store_uint(0, 32)
              .store_slice("💸Reward 🔗 tonMinute")
              .end_cell(); 
            send_raw_message(ref_msg, 3);
            ~strdump("отправили награду");
        }
    }
  }
}

() send_echo_message(slice address, int amount, int choice, slice to, int opcode, slice ref_addr) impure {
  if ((opcode == op::echo_minutka) & (amount < const::min_tons_for_playing)) {
    return ();
  }
  if ((opcode == op::echo_dice) & (amount < const::min_tons_for_playing_dice)) {
    return ();
  }

  slice ref_address = ref_addr;

  cell msg = begin_cell()
      .store_uint(0x18, 6)
      .store_slice(to)
      .store_coins(amount)
      .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
      .store_uint(opcode, 32)
      .store_slice(ref_address)
      .store_uint(choice, 32)
      .store_slice(address)
      .end_cell();
  send_raw_message(msg, 3);
}

() op_withdraw(int withdraw_amount, slice owner_address) impure {
  var [balance, _] = get_balance();
  throw_unless(error::insufficient_balance, balance >= withdraw_amount);
  int return_value = min(withdraw_amount, balance - const::min_tons_for_storage);
  send_grams(owner_address, return_value);
}

int balance() method_id {
  var [balance, _] = get_balance();
  return balance;
}

(slice, slice, slice) get_contract_data() method_id {
    (slice owner_address, slice main_address, slice echo_address) = load_data();
    return (owner_address, main_address, echo_address);
}